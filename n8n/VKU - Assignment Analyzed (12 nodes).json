        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  systemInstruction: { parts: [{ text: \"Bạn là trợ lý nhận xét bài nộp của sinh viên. Dựa trên dữ liệu bài nộp được cung cấp, đưa ra nhận xét khách quan, cụ thể, mang tính xây dựng, bằng tiếng Việt. Không bịa thông tin không có trong dữ liệu. Điểm chấm theo thang 0 đến 10.\" }] },\n  contents: [{ role: \"user\", parts: [{ text: \"Thông tin sự kiện:\\n\" + JSON.stringify($('Nhận sự kiện').first().json.body) + \"\\n\\nDữ liệu bài nộp:\\n\" + JSON.stringify($json).slice(0, 30000) }] }],\n  generationConfig: {\n    temperature: 0.3,\n    responseMimeType: \"application/json\",\n    responseSchema: {\n      type: \"OBJECT\",\n      properties: {\n        summary: { type: \"STRING\" },\n        score: { type: \"NUMBER\" },\n        strengths: { type: \"ARRAY\", items: { type: \"STRING\" } },\n        weaknesses: { type: \"ARRAY\", items: { type: \"STRING\" } },\n        suggestions: { type: \"ARRAY\", items: { type: \"STRING\" } }\n      },\n      required: [\"summary\", \"score\", \"strengths\", \"weaknesses\", \"suggestions\"]\n    }\n  }\n}) }}",
