        "jsCode": "// Giữ 7 ngày để lần gửi lại trong thời gian đó nhận đúng kết quả lần đầu.\nconst KEEP_MS = 7 * 24 * 60 * 60 * 1000;\nreturn [{ json: {\n  deliveryId: $('Chuẩn bị chống trùng').first().json.deliveryId,\n  status: 'done',\n  expiresAt: new Date(Date.now() + KEEP_MS).toISOString(),\n  response: $('Xử lý sự kiện').first().json,\n} }];"
