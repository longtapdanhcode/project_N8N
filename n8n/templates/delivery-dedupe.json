    {
      "parameters": {
        "jsCode": "// THAY node này bằng các bước xử lý thật (ghi điểm danh, đăng ký, gửi email...).\n// Bật \"On Error → Continue (using error output)\" cho các bước có thể lỗi và nối\n// đầu ra lỗi vào \"Bỏ đánh dấu khi lỗi\" để backend gửi lại được.\nconst body = $('Kiểm tra HMAC').first().json.body;\nreturn [{ json: { ok: true, received: body } }];"
      },
