    {
      "parameters": {
        "jsCode": "// Chống trùng theo X-Delivery-Id: backend giữ nguyên mã này qua các lần gửi lại.\n// Mã chỉ có tác dụng khi bộ sưu tập n8n_deliveries có chỉ mục duy nhất trên deliveryId\n// (backend tự tạo khi khởi động, xem n8n/README.md).\nconst SCOPE = 'doi-ten-theo-workflow';\nconst LEASE_MS = 10 * 60 * 1000; // quá hạn này mà chưa xong thì coi như bỏ dở, cho xử lý lại\nconst raw = String($('Nhận sự kiện').first().json.headers?.['x-delivery-id'] ?? '').trim();\nconst valid = /^[A-Za-z0-9:._-]{1,200}$/.test(raw);\nconst now = Date.now();\nreturn [{ json: {\n  // Thiếu mã (backend cũ) thì dùng mã của lần chạy này: vẫn chạy, chỉ không bỏ trùng được.\n  deliveryId: SCOPE + ':' + (valid ? raw : 'no-id:' + $execution.id),\n  scope: SCOPE,\n  status: 'processing',\n  claimedAt: new Date(now).toISOString(),\n  expiresAt: new Date(now + LEASE_MS).toISOString(),\n} }];"
      },
