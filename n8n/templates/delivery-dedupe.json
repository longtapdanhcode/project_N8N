    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\n// Backend gửi \"sha256=<hex>\"; chấp nhận cả dạng chỉ có hex.\nconst header = item.json.headers?.['x-signature'];\nconst signature = typeof header === 'string' ? header.replace(/^sha256=/i, '').trim() : '';\nconst secret = $env.WEBHOOK_SECRET;\nlet valid = false;\nlet body = {};\nif (secret && /^[0-9a-f]{64}$/i.test(signature) && item.binary?.data) {\n  const raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const expected = crypto.createHmac('sha256', secret).update(raw).digest();\n  valid = crypto.timingSafeEqual(Buffer.from(signature, 'hex'), expected);\n  if (valid) {\n    try { body = JSON.parse(raw.toString('utf8')); } catch { valid = false; }\n  }\n}\nreturn [{ json: { valid, body } }];"
      },
