# Backend API — URL reachable from the frontend server
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3001

# Session signing key. `npm run dev` uses a temporary key when this is empty.
# Production refuses to start without a fixed random key of 32+ characters:
#   openssl rand -hex 48
AUTH_SESSION_SECRET=

# Portal key sent as x-portal-key on every backend call. Must equal
# PORTAL_API_KEY in backend/.env. Server-only: never prefix with NEXT_PUBLIC_.
# Production refuses to start without it.
PORTAL_API_KEY=

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For,
# so login rate limits can also count attempts per client IP.
TRUST_PROXY=false
