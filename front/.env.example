# Backend API — URL reachable from the frontend server
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3001

# Root launcher generates a temporary session key automatically.
# For a persistent deployment, set a random secret of at least 32 characters.
AUTH_SESSION_SECRET=

# Optional: teacher submissions list reads MongoDB on the server.
MONGODB_URI=mongodb://127.0.0.1:27017/vku-ai-support
