# Biến cho docker compose (sao chép thành .env ở thư mục gốc; không commit .env).
# Khóa riêng của backend (Gemini, Supabase, VAPID, TIMETABLE_PERIODS…) để trong backend/.env.
# Tạo mỗi khóa bằng: openssl rand -hex 48 (mỗi khóa một giá trị khác nhau).

# --- Khóa dùng chung (bắt buộc khi chạy bằng Docker) ---
# Ký cookie phiên của cổng 3000. Thiếu thì cổng không khởi động.
AUTH_SESSION_SECRET=
# Cổng 3000 gửi kèm mọi request tới backend. Thiếu thì cả hai không khởi động.
PORTAL_API_KEY=
# Ký HMAC giữa backend và n8n (n8n đọc qua $env.WEBHOOK_SECRET).
WEBHOOK_SECRET=
# n8n gọi lại backend (/api/internal, /internal/theses) bằng header x-internal-api-key.
# Đặt cùng giá trị trong credential "Header Auth" của n8n.
N8N_INTERNAL_API_KEY=

# --- Cổng mở ra máy (tùy chọn) ---
PORTAL_HOST_PORT=3000
# Các dịch vụ dưới chỉ mở trên 127.0.0.1.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6380
N8N_HOST_PORT=5678

# --- n8n (tùy chọn) ---
# Địa chỉ công khai n8n dùng để hiển thị URL webhook.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/

# Chỉ bật khi cổng 3000 chạy sau reverse proxy tự ghi X-Forwarded-For.
TRUST_PROXY=false

# --- Postgres pgvector cục bộ (profile "pgvector", backend hiện không dùng) ---
PGVECTOR_PASSWORD=
PGVECTOR_HOST_PORT=5432
