PORT=3001
# Khi chạy backend trên máy với hạ tầng từ docker-compose.yml (Redis mở ở 6380).
# Chạy cả backend bằng Docker thì compose tự đặt các địa chỉ này.
MONGO_URI=mongodb://localhost:27017/vku-ai-support
REDIS_HOST=localhost
REDIS_PORT=6380
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/test-event
N8N_COURSE_REGISTRATION_URL=http://localhost:5678/webhook/course-registration
N8N_ACADEMIC_WARNING_URL=http://localhost:5678/webhook/academic-warning-alert
N8N_ATTENDANCE_SYNC_URL=http://localhost:5678/webhook/attendance-offline-sync
N8N_FAQ_URL=http://localhost:5678/webhook/student-faq
N8N_ASSIGNMENT_URL=http://localhost:5678/webhook/assignment-analyzed
N8N_THESIS_URL=http://localhost:5678/webhook/thesis-milestone-updated
N8N_INTERNAL_API_KEY=replace_with_a_separate_random_key
# Khóa cổng: mọi request từ cổng 3000 phải mang header x-portal-key bằng giá trị này
# (trừ route n8n /api/internal, /internal/theses và webhook Supabase có khóa riêng).
# Đặt GIỐNG HỆT PORTAL_API_KEY trong front/.env. Tạo: openssl rand -hex 48
# Để trống chỉ khi chạy dev trên máy; NODE_ENV=production thiếu khóa thì backend không khởi động.
PORTAL_API_KEY=
WEBHOOK_SECRET=replace_with_a_separate_random_key

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (Hybrid Search & pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Web Push báo kết quả chấm bài (tùy chọn; thiếu thì tắt thông báo đẩy, PWA vẫn tự hỏi kết quả).
# Sinh cặp khóa: npx web-push generate-vapid-keys. Không commit khóa riêng.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-admin-mailbox@example.com
# Giờ các tiết học (tùy chọn). Mặc định: tiết 50 phút, sáng tiết 1 từ 07:00, chiều tiết 6 từ 13:00.
# TIMETABLE_PERIODS=["07:00-07:50","07:50-08:40","08:40-09:30","09:30-10:20","10:20-11:10","13:00-13:50","13:50-14:40","14:40-15:30","15:30-16:20","16:20-17:10"]
# Secret riêng cho webhook đồng bộ sinh viên (>= 32 ký tự, khớp với Vault: student_sync_webhook_secret)
SUPABASE_WEBHOOK_SECRET=replace_with_a_separate_random_key_of_32_chars_or_more
